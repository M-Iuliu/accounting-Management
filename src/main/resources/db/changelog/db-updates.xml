    <changeSet author="andreea" id="notification-alter-date-11">
        <preConditions onFail="MARK_RAN">
            <columnExists tableName="notification" columnName="create_date"/>
        </preConditions>
        <sql>
            ALTER TABLE notification
            ALTER COLUMN create_date TYPE DATE USING create_date::date;
        </sql>
        <sql>
            ALTER TABLE notification
            ALTER COLUMN update_date TYPE DATE USING update_date::date;
        </sql>

        <!--        <modifyDataType tableName="notification" columnName="create_date" newDataType="DATE"/>-->
        <!--        <modifyDataType tableName="notification" columnName="update_date" newDataType="DATE"/>-->
    </changeSet>

