    <changeSet author="andreea" id="reservation-offer-nullable-28">
        <preConditions onFail="MARK_RAN">
            <columnExists tableName="reservation" columnName="offer_id"/>
        </preConditions>
        <dropNotNullConstraint tableName="reservation" columnName="offer_id"/>
    </changeSet>


    <changeSet author="andreea" id="offer-add-currency-29">
        <preConditions onFail="MARK_RAN">
            <not>
                <columnExists tableName="offer" columnName="currency"/>
            </not>
        </preConditions>
        <addColumn tableName="offer">
            <column name="currency" type="VARCHAR(255)"/>
        </addColumn>
    </changeSet>

    <!-- Client Audit Fields - Step 1: Add columns -->
    <changeSet author="claude" id="client-add-audit-fields-30">
        <preConditions onFail="MARK_RAN">
            <not>
                <columnExists tableName="client" columnName="created_by"/>
            </not>
        </preConditions>
        <addColumn tableName="client">
            <column name="created_by" type="VARCHAR(255)">
                <constraints nullable="true"/>
            </column>
            <column name="created_date" type="TIMESTAMP WITHOUT TIME ZONE">
                <constraints nullable="true"/>
            </column>
            <column name="modified_by" type="VARCHAR(255)">
                <constraints nullable="true"/>
            </column>
            <column name="modified_date" type="TIMESTAMP WITHOUT TIME ZONE">
                <constraints nullable="true"/>
            </column>
        </addColumn>
    </changeSet>

    <!-- Client Audit Fields - Step 2: Set default values for existing records -->
    <changeSet author="claude" id="client-add-audit-fields-31">
        <preConditions onFail="MARK_RAN">
            <columnExists tableName="client" columnName="created_by"/>
        </preConditions>
        <sql>
            UPDATE client
            SET created_by = 'SYSTEM',
                created_date = CURRENT_TIMESTAMP,
                modified_by = 'SYSTEM',
                modified_date = CURRENT_TIMESTAMP
            WHERE created_by IS NULL;
        </sql>
    </changeSet>

