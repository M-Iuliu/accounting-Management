    <!-- Offer Audit Fields - Step 2: Set default values for existing records -->
    <changeSet author="claude" id="offer-add-audit-fields-33">
        <preConditions onFail="MARK_RAN">
            <columnExists tableName="offer" columnName="created_by"/>
        </preConditions>
        <sql>
            UPDATE offer
