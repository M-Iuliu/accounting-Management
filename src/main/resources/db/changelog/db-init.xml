<?xml version="1.1" encoding="UTF-8" standalone="no"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">
    <!-- ChangeSet 1 -->
    <changeSet author="emi (generated)" id="offer-1">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="offer"/>
            </not>
        </preConditions>
        <createTable tableName="offer">
            <column autoIncrement="true" name="offer_id" type="BIGINT">
                <constraints nullable="false" primaryKey="true" primaryKeyName="PK_OFFER"/>
            </column>
            <column name="client_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="adults_no" type="INTEGER">
                <constraints nullable="false"/>
            </column>
            <column name="children_no" type="INTEGER">
                <constraints nullable="false"/>
            </column>
            <column name="period" type="VARCHAR(255)"/>
            <column name="destination" type="VARCHAR(255)"/>
            <column name="status" type="VARCHAR(255)"/>
            <column name="advance" type="FLOAT8">
                <constraints nullable="false"/>
            </column>
            <column name="budget" type="FLOAT8">
                <constraints nullable="false"/>
            </column>
            <column name="acquisition_price" type="FLOAT8">
                <constraints nullable="false"/>
            </column>
            <column name="commission" type="FLOAT8">
                <constraints nullable="false"/>
            </column>
            <column name="gross_price" type="FLOAT8">
                <constraints nullable="false"/>
            </column>
            <column name="obs" type="VARCHAR(255)"/>
            <column name="offer_date" type="TIMESTAMP WITHOUT TIME ZONE"/>
        </createTable>
    </changeSet>

    <!-- ChangeSet 2 -->
    <changeSet author="emi (generated)" id="reservation-2">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="reservation"/>
            </not>
        </preConditions>
        <createTable tableName="reservation">
            <column autoIncrement="true" name="reservation_id" type="BIGINT">
                <constraints nullable="false" primaryKey="true" primaryKeyName="PK_RESERVATION"/>
            </column>
            <column name="client_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="booking_ref" type="VARCHAR(255)"/>
            <column name="booked_date" type="TIMESTAMP WITHOUT TIME ZONE"/>
            <!--            <column name="children_age" type="VARCHAR(255)"/>-->
            <!--            <column name="participants" type="VARCHAR(255)"/>-->
            <column name="departure_date" type="TIMESTAMP WITHOUT TIME ZONE"/>
            <column name="return_date" type="TIMESTAMP WITHOUT TIME ZONE"/>
            <column name="destination" type="VARCHAR(255)"/>
            <column name="hotel" type="VARCHAR(255)"/>
            <column name="room_no" type="INTEGER"/>
            <column name="transport" type="VARCHAR(255)"/>
            <column name="price" type="FLOAT8">
                <constraints nullable="false"/>
            </column>
            <column name="receipted" type="FLOAT8">
                <constraints nullable="false"/>
            </column>
            <column name="balance" type="FLOAT8">
                <constraints nullable="false"/>
            </column>
            <column name="balance_due_date" type="TIMESTAMP WITHOUT TIME ZONE"/>
            <column name="offer_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="currency" type="FLOAT8">
                <constraints nullable="false"/>
            </column>
            <column name="provider_id" type="BIGINT"/>
        </createTable>
    </changeSet>

    <!-- ChangeSet 3 -->
    <changeSet author="emi (generated)" id="client-3">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="client"/>
            </not>
        </preConditions>
        <createTable tableName="client">
            <column autoIncrement="true" name="client_id" type="BIGINT">
                <constraints nullable="false" primaryKey="true" primaryKeyName="PK_CLIENT"/>
            </column>
            <column name="email" type="VARCHAR(255)"/>
            <column name="name" type="VARCHAR(255)"/>
            <column name="surname" type="VARCHAR(255)"/>
            <column name="telephone" type="VARCHAR(255)"/>
            <column name="obs" type="VARCHAR(255)"/>
            <column name="title" type="VARCHAR(255)"/>
        </createTable>
    </changeSet>

    <!-- ChangeSet 4 -->
    <changeSet author="emi (generated)" id="provider-4">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="provider"/>
            </not>
        </preConditions>
        <createTable tableName="provider">
            <column autoIncrement="true" name="provider_id" type="BIGINT">
                <constraints nullable="false" primaryKey="true" primaryKeyName="PK_PROVIDER"/>
            </column>
            <column name="provider_name" type="VARCHAR(255)"/>
            <column name="telephone" type="VARCHAR(255)"/>
            <column name="email" type="VARCHAR(255)"/>
            <column name="web_link" type="VARCHAR(255)"/>
        </createTable>
    </changeSet>

    <!-- ChangeSet 5 -->
    <changeSet author="emi (generated)" id="FK_RESERVATION_OFFER-5">
        <preConditions onFail="MARK_RAN">
            <not>
                <foreignKeyConstraintExists foreignKeyName="FK_RESERVATION_OFFER"/>
            </not>
        </preConditions>
        <addForeignKeyConstraint baseColumnNames="offer_id" baseTableName="reservation"
                                 constraintName="FK_RESERVATION_OFFER" referencedColumnNames="offer_id"
                                 referencedTableName="offer"/>
    </changeSet>

    <!-- ChangeSet 6 -->
    <changeSet author="emi (generated)" id="UK_RESERVATION_OFFER-6">
        <preConditions onFail="MARK_RAN">
            <not>
                <uniqueConstraintExists tableName="reservation" constraintName="UK_RESERVATION_OFFER"/>
            </not>
        </preConditions>
        <addUniqueConstraint columnNames="offer_id" constraintName="UK_RESERVATION_OFFER" tableName="reservation"/>
    </changeSet>

    <!-- ChangeSet 7 -->
    <changeSet author="emi (generated)" id="FK_RESERVATION_CLIENT-7">
        <preConditions onFail="MARK_RAN">
            <not>
                <foreignKeyConstraintExists foreignKeyName="FK_RESERVATION_CLIENT"/>
            </not>
        </preConditions>
        <addForeignKeyConstraint baseColumnNames="client_id" baseTableName="reservation"
                                 constraintName="FK_RESERVATION_CLIENT" referencedColumnNames="client_id"
                                 referencedTableName="client"/>
    </changeSet>

    <!-- ChangeSet 8 -->
    <changeSet author="emi (generated)" id="FK_RESERVATION_PROVIDER-8">
        <preConditions onFail="MARK_RAN">
            <not>
                <foreignKeyConstraintExists foreignKeyName="FK_RESERVATION_PROVIDER"/>
            </not>
        </preConditions>
        <addForeignKeyConstraint baseColumnNames="provider_id" baseTableName="reservation"
                                 constraintName="FK_RESERVATION_PROVIDER" referencedColumnNames="provider_id"
                                 referencedTableName="provider"/>
    </changeSet>

    <!-- ChangeSet 9 -->
    <changeSet author="andreea" id="comment-9">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="comment"/>
            </not>
        </preConditions>
        <createTable tableName="comment">
            <column autoIncrement="true" name="comment_id" type="BIGINT">
                <constraints nullable="false" primaryKey="true" primaryKeyName="PK_COMMENT"/>
            </column>
            <column name="message" type="VARCHAR(255)"/>
            <column name="date" type="TIMESTAMP WITHOUT TIME ZONE"/>
            <column name="context_type" type="VARCHAR(255)"/>
            <column name="context_id" type="BIGINT"/>
            <column name="comment_type" type="VARCHAR(255)"/>
            <column name="reply_to" type="VARCHAR(255)"/>
        </createTable>
    </changeSet>

    <!-- ChangeSet 10 -->
    <changeSet author="andreea" id="notification-10">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="notification"/>
            </not>
        </preConditions>
        <createTable tableName="notification">
            <column autoIncrement="true" name="notification_id" type="BIGINT">
                <constraints nullable="false" primaryKey="true" primaryKeyName="PK_NOTIFICATION"/>
            </column>
            <column name="context_id" type="BIGINT"/>
            <column name="context_type" type="VARCHAR(255)"/>
            <column name="message" type="VARCHAR(255)"/>
            <column name="notification_type" type="VARCHAR(255)"/>
            <column name="notification_status" type="VARCHAR(255)"/>
            <column name="date" type="TIMESTAMP WITHOUT TIME ZONE"/>
            <column name="client_id" type="BIGINT"/>
        </createTable>
    </changeSet>


    <!-- ChangeSet 11 -->
    <changeSet author="andreea" id="FK_NOTIFICATION_CLIENT-11">
        <preConditions onFail="MARK_RAN">
            <not>
                <foreignKeyConstraintExists foreignKeyName="FK_NOTIFICATION_CLIENT"/>
            </not>
        </preConditions>
        <addForeignKeyConstraint baseColumnNames="client_id" baseTableName="notification"
                                 constraintName="FK_NOTIFICATION_CLIENT" referencedColumnNames="client_id"
                                 referencedTableName="client"/>
    </changeSet>
</databaseChangeLog>
